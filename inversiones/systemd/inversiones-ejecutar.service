[Unit]
Description=inversiones: ejecuta el plan del titular en eToro (primer laborable de la semana, 16:00)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/work/inversiones
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/work/inversiones/.env
# solo el primer laborable de la semana en Madrid (exit 1 = se omite)
ExecCondition=%h/work/inversiones/.venv/bin/python -m inversiones.laborable
ExecStart=%h/work/inversiones/.venv/bin/python -m inversiones.ejecutar --perfil titular
TimeoutStartSec=1h
SuccessExitStatus=2
