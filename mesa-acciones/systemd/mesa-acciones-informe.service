[Unit]
Description=Mesa acciones: resumen del día a la app (solo si hubo operaciones)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/work/mesa-acciones
EnvironmentFile=-%h/work/mesa-acciones/.env
ExecStart=%h/work/mesa-acciones/.venv/bin/python -m mesa_acciones informe
