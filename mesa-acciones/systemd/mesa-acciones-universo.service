[Unit]
Description=Mesa acciones: recalcula el universo líquido
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/work/mesa-acciones
EnvironmentFile=-%h/work/mesa-acciones/.env
ExecStart=%h/work/mesa-acciones/.venv/bin/python -m mesa_acciones universo
